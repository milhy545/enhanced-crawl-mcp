# Crawl MCP Environment Variables
# Copy this file to .env and customize values

# Application Settings
CRAWL_MCP_APP_NAME=Crawl MCP
CRAWL_MCP_APP_VERSION=1.0.0
CRAWL_MCP_APP_DESCRIPTION=A microservice for crawling web pages for AI context.

# Server Settings
CRAWL_MCP_HOST=0.0.0.0
CRAWL_MCP_PORT=8012
CRAWL_MCP_WORKERS=1
CRAWL_MCP_RELOAD=false

# Logging Settings
CRAWL_MCP_LOG_LEVEL=INFO
CRAWL_MCP_LOG_FORMAT=json
CRAWL_MCP_LOG_FILE=logs/app.log

# Crawler Settings
CRAWL_MCP_CRAWLER_TIMEOUT=30
CRAWL_MCP_CRAWLER_MAX_RETRIES=3
CRAWL_MCP_CRAWLER_RETRY_DELAY=1
CRAWL_MCP_CRAWLER_USER_AGENT=
CRAWL_MCP_CRAWLER_MAX_CONCURRENT=5

# API Settings
CRAWL_MCP_API_PREFIX=/api/v1
CRAWL_MCP_CORS_ENABLED=true
CRAWL_MCP_CORS_ORIGINS=*
CRAWL_MCP_RATE_LIMIT_ENABLED=true
CRAWL_MCP_RATE_LIMIT_REQUESTS=100

# Security Settings
CRAWL_MCP_ALLOWED_SCHEMES=http,https
CRAWL_MCP_BLOCKED_DOMAINS=

# Job Settings
CRAWL_MCP_JOB_CLEANUP_INTERVAL=3600
CRAWL_MCP_JOB_MAX_AGE=86400
